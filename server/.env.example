# Server Configuration
PORT=5000

# A long, random, secret string used to sign customer/admin session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production — without it, sessions are signed with a publicly-known
# fallback value and anyone could forge an admin session.
SESSION_SECRET=

# Admin / rider console PINs. The defaults baked into the code (9791 / 8888) have been
# public since day one (they shipped in the client bundle) — treat them as compromised
# and set real values here before going live.
ADMIN_PIN=
RIDER_PIN=

# Phone number that receives "new order" owner alerts (10 digits, no country code)
OWNER_ALERT_PHONE=

# Supabase (Settings -> API in your Supabase project dashboard)
SUPABASE_URL=
# Use the SERVICE ROLE key here, not the anon key — this key never leaves the server.
# It lets the backend read/write regardless of Row Level Security policies, which you
# should enable on the orders/customers tables so the (separate, public) anon key can't
# be used to read or write them directly.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay Payment Gateway (Real UPI/Cards checkout)
# Sign up at https://razorpay.com to get your keys. Leave blank to run in demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Fast2SMS API Key (Real Indian SMS OTPs)
# Sign up at https://www.fast2sms.com to get your API key. Leave blank to just log
# OTPs to the server console (fine for local development only).
FAST2SMS_API_KEY=
